<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:CinemaBooking.Domain.Entities;assembly=CinemaBooking.Domain"
             xmlns:views="clr-namespace:CinemaBooking.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="CinemaBooking.Desktop.Views.HallsView"
             x:DataType="views:HallsView">

	<StackPanel Margin="20">
		<TextBlock Text="Залы" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

		<!-- Панель поиска -->
		<Border Background="#2D2D2D" Padding="15" CornerRadius="5" Margin="0,0,0,20">
			<StackPanel>
				<TextBlock Text="Поиск залов" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
				<Grid ColumnDefinitions="*,150">
					<TextBox x:Name="SearchTextBox"
                             Watermark="Введите название зала..."
                             Height="35"
                             FontSize="14"/>
					<Button Grid.Column="1"
                            Content="Поиск"
                            Click="OnSearchClick"
                            Height="35"
                            FontSize="14"
                            Margin="10,0,0,0"/>
				</Grid>
				<Button Content="Показать все"
                        Click="OnShowAllClick"
                        Width="150"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"/>
			</StackPanel>
		</Border>

		<Button Content="Добавить зал"
                Click="OnAddHallClick"
                Width="150"
                HorizontalAlignment="Left"
                Margin="0,0,0,20"/>

		<TextBlock>
			<TextBlock.Text>
				<Binding Path="Halls.Count" StringFormat="Найдено залов: {0}"/>
			</TextBlock.Text>
		</TextBlock>

		<ListBox ItemsSource="{Binding Halls}"
                 Height="400"
                 BorderBrush="Gray"
                 BorderThickness="1"
                 Margin="0,10,0,0">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="entities:Hall">
					<Grid ColumnDefinitions="*,120">
						<StackPanel Margin="10">
							<TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
						</StackPanel>
						<Button Grid.Column="1"
                                Content="Удалить"
                                Click="OnDeleteHallClick"
                                Height="35"
                                Background="#f44336"
                                Foreground="White"
                                Margin="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</StackPanel>

</UserControl>