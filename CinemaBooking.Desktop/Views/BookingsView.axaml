<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:CinemaBooking.Domain.Entities;assembly=CinemaBooking.Domain"
             xmlns:views="clr-namespace:CinemaBooking.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="CinemaBooking.Desktop.Views.BookingsView"
             x:DataType="views:BookingsView">

	<StackPanel Margin="20">
		<TextBlock Text="Бронирования" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

		<Button Content="Создать бронирование"
                Click="OnAddBookingClick"
                Width="200"
                HorizontalAlignment="Left"
                Margin="0,0,0,20"/>

		<ListBox ItemsSource="{Binding Bookings}"
                 Height="400"
                 BorderBrush="Gray"
                 BorderThickness="1">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="entities:Booking">
					<StackPanel Margin="10">
						<TextBlock>
							<TextBlock.Text>
								<Binding Path="Id" StringFormat="ID бронирования: {0}"/>
							</TextBlock.Text>
						</TextBlock>
						<TextBlock>
							<TextBlock.Text>
								<Binding Path="User.Email" StringFormat="Пользователь: {0}"/>
							</TextBlock.Text>
						</TextBlock>
						<TextBlock>
							<TextBlock.Text>
								<Binding Path="Session.Movie.Title" StringFormat="Фильм: {0}"/>
							</TextBlock.Text>
						</TextBlock>
						<TextBlock>
							<TextBlock.Text>
								<Binding Path="Session.StartTime" StringFormat="Время сеанса: {0:dd.MM.yyyy HH:mm}"/>
							</TextBlock.Text>
						</TextBlock>
						<TextBlock>
							<TextBlock.Text>
								<Binding Path="Status" StringFormat="Статус: {0}"/>
							</TextBlock.Text>
						</TextBlock>
						<TextBlock>
							<TextBlock.Text>
								<Binding Path="CreatedAt" StringFormat="Создано: {0:dd.MM.yyyy HH:mm}"/>
							</TextBlock.Text>
						</TextBlock>
						<Border Height="1" Background="LightGray" Margin="0,10,0,0"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</StackPanel>

</UserControl>