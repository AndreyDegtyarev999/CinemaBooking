<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:CinemaBooking.Domain.Entities;assembly=CinemaBooking.Domain"
             xmlns:views="clr-namespace:CinemaBooking.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="CinemaBooking.Desktop.Views.MoviesView"
             x:DataType="views:MoviesView">
    
    <StackPanel Margin="20">
        <TextBlock Text="Фильмы" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <!-- Панель поиска -->
        <Border Background="#2D2D2D" Padding="15" CornerRadius="5" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Поиск фильмов" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,150">
                    <TextBox x:Name="SearchTextBox" 
                             Text="{Binding SearchText}"
                             Watermark="Введите название фильма..."
                             Height="35"
                             FontSize="14"/>
                    <Button Grid.Column="1"
                            Content="Поиск" 
                            Click="OnSearchClick"
                            Height="35"
                            FontSize="14"
                            Margin="10,0,0,0"/>
                </Grid>
                <Button Content="Показать все" 
                        Click="OnShowAllClick"
                        Width="150"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        
        <TextBlock>
            <TextBlock.Text>
                <Binding Path="Movies.Count" StringFormat="Найдено фильмов: {0}"/>
            </TextBlock.Text>
        </TextBlock>
        
        <ListBox ItemsSource="{Binding Movies}" 
                 Height="400"
                 BorderBrush="Gray"
                 BorderThickness="1"
                 Margin="0,10,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="entities:Movie">
                    <StackPanel Margin="10">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding Genre}" FontStyle="Italic"/>
                        <TextBlock Text="{Binding Description}"/>
                        <TextBlock>
                            <TextBlock.Text>
                                <Binding Path="Duration" StringFormat="Длительность: {0} мин."/>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock>
                            <TextBlock.Text>
                                <Binding Path="ReleaseDate" StringFormat="Дата выхода: {0:dd.MM.yyyy}"/>
                            </TextBlock.Text>
                        </TextBlock>
                        <Border Height="1" Background="LightGray" Margin="0,10,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
    
</UserControl>