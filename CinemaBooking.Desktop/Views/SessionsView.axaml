<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:entities="clr-namespace:CinemaBooking.Domain.Entities;assembly=CinemaBooking.Domain"
             xmlns:views="clr-namespace:CinemaBooking.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="CinemaBooking.Desktop.Views.SessionsView"
             x:DataType="views:SessionsView">

	<StackPanel Margin="20">
		<TextBlock Text="Сеансы" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

		<!-- Панель поиска -->
		<Border Background="#2D2D2D" Padding="15" CornerRadius="5" Margin="0,0,0,20">
			<StackPanel>
				<TextBlock Text="Поиск сеансов" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
				<Grid ColumnDefinitions="*,150">
					<TextBox x:Name="SearchTextBox"
                             Watermark="Введите название фильма..."
                             Height="35"
                             FontSize="14"/>
					<Button Grid.Column="1"
                            Content="Поиск"
                            Click="OnSearchClick"
                            Height="35"
                            FontSize="14"
                            Margin="10,0,0,0"/>
				</Grid>
				<Button Content="Показать все"
                        Click="OnShowAllClick"
                        Width="150"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"/>
			</StackPanel>
		</Border>

		<!-- Кнопка добавления сеанса -->
		<Button Content="Добавить сеанс"
                Click="OnAddSessionClick"
                Width="180"
                Height="40"
                HorizontalAlignment="Left"
                Margin="0,0,0,20"
                Background="#4CAF50"
                Foreground="White"
                FontSize="14"/>

		<TextBlock>
			<TextBlock.Text>
				<Binding Path="Sessions.Count" StringFormat="Найдено сеансов: {0}"/>
			</TextBlock.Text>
		</TextBlock>

		<ListBox ItemsSource="{Binding Sessions}"
                 Height="400"
                 BorderBrush="Gray"
                 BorderThickness="1"
                 Margin="0,10,0,0">
			<ListBox.ItemTemplate>
				<DataTemplate x:DataType="entities:Session">
					<Grid ColumnDefinitions="*,120">
						<StackPanel Margin="10">
							<TextBlock Text="{Binding Movie.Title}" FontWeight="Bold" FontSize="16"/>
							<TextBlock>
								<TextBlock.Text>
									<Binding Path="Hall.Name" StringFormat="Зал: {0}"/>
								</TextBlock.Text>
							</TextBlock>
							<TextBlock>
								<TextBlock.Text>
									<Binding Path="StartTime" StringFormat="Время начала: {0:dd.MM.yyyy HH:mm}"/>
								</TextBlock.Text>
							</TextBlock>
							<TextBlock>
								<TextBlock.Text>
									<Binding Path="EndTime" StringFormat="Время окончания: {0:dd.MM.yyyy HH:mm}"/>
								</TextBlock.Text>
							</TextBlock>
						</StackPanel>
						<Button Grid.Column="1"
                                Content="Удалить"
                                Click="OnDeleteSessionClick"
                                Height="35"
                                Background="#f44336"
                                Foreground="White"
                                Margin="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
					</Grid>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</StackPanel>

</UserControl>